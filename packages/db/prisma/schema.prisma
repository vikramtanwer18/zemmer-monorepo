/// One row per recipient per channel. EMAIL rows are delivered by the worker (via the outbox).
model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  /// The global user (staff or member app account); null for email-only recipients.
  userId      String?              @map("user_id") @db.Uuid
  memberId    String?              @map("member_id") @db.Uuid
  email       String?
  channel     NotificationChannel
  category    NotificationCategory
  templateKey String               @map("template_key")
  title       String
  body        String
  link        String?
  status      DeliveryStatus       @default(PENDING)
  /// Why it was skipped or failed (no consent, opted out, provider error).
  statusNote  String?              @map("status_note")
  /// Stops duplicates, e.g. "expiring:<membershipId>:7".
  dedupeKey   String?              @map("dedupe_key")
  readAt      DateTime?            @map("read_at")
  sentAt      DateTime?            @map("sent_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channel, dedupeKey])
  @@index([tenantId, userId, channel, readAt])
  @@index([tenantId, memberId])
  @@map("notification")
  @@schema("app")
}

