  @@unique([tenantId, id])
  @@unique([tenantId, leadId])
  @@index([tenantId, referrerMemberId])
  @@map("referral")
  @@schema("app")
}

// ===================================================================================
// M8: intelligence — KPI rollups (derived data), the platform AI provider, Copilot request log.
// ===================================================================================

/// Derived data: one row per branch per tenant-local day, written by the nightly `metrics.rollup`
/// job and by `pnpm metrics:rebuild`. Never the source of truth: every value can be recomputed from
/// the live tables, except the active/paused snapshots for days before the first nightly run, which
/// are reconstructed from membership dates (`reconstructed` = true).
model MetricDaily {
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  day           DateTime @db.Date
  activeMembers Int      @default(0) @map("active_members")
  pausedMembers Int      @default(0) @map("paused_members")
  newMembers    Int      @default(0) @map("new_members")
  checkIns      Int      @default(0) @map("check_ins")
  uniqueVisits  Int      @default(0) @map("unique_visits")
  invoicedMinor BigInt   @default(0) @map("invoiced_minor")
  paymentsMinor BigInt   @default(0) @map("payments_minor")
  refundsMinor  BigInt   @default(0) @map("refunds_minor")
  reconstructed Boolean  @default(false)
  computedAt    DateTime @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@id([tenantId, branchId, day])
  @@index([tenantId, day])
  @@map("metric_daily")
  @@schema("app")
}

/// The platform's OpenAI-compatible AI provider (one row, id "default"). Switch provider or model
/// here without code changes. The API key is sealed with the platform SecretBox and never sent to
/// a browser; gyms' runtime role can read only the columns needed to make a request.
model AiProvider {
  id                  String    @id @default("default")
  label               String
  baseUrl             String    @map("base_url")
  model               String
  apiKeySealed        String?   @map("api_key_sealed")
  /// Last 4 characters, for the admin screen.
  apiKeyHint          String?   @map("api_key_hint")
  timeoutMs           Int       @default(30000) @map("timeout_ms")
  maxTokens           Int       @default(800) @map("max_tokens")
  enabled             Boolean   @default(false)
  /// Detected by "Test connection": null = not tested. False = Copilot uses the fallback summary.
  supportsTools       Boolean?  @map("supports_tools")
  lastTestedAt        DateTime? @map("last_tested_at")
  lastTestOk          Boolean?  @map("last_test_ok")
  lastTestMessage     String?   @map("last_test_message")
  /// Copilot request logs (no question or answer text) are deleted after this many days.
  logRetentionDays    Int       @default(90) @map("log_retention_days")
  /// Per gym: at most this many questions a minute (and 10× per day).
  tenantRatePerMinute Int       @default(6) @map("tenant_rate_per_minute")
  updatedById         String?   @map("updated_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("ai_provider")
  @@schema("platform")
}

enum AiRequestOutcome {
  ANSWERED
  /// The provider can't call tools (or failed); the answer is the server-built summary.
  FALLBACK
  /// The answer had numbers not found in tool results; shown with a warning.
  FLAGGED
  ERROR

  @@schema("app")
}

/// One Copilot question: which tools ran, how long, token counts. Never the question, the answer
/// or tool results (they can hold member data). Deleted after the provider's log retention.
model AiRequestLog {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  outcome           AiRequestOutcome
  /// TOOLS | FALLBACK | FAKE
  mode              String
  model             String?
  /// [{ name, ms, ok }]
  toolCalls         Json             @default("[]") @map("tool_calls")
  promptTokens      Int              @default(0) @map("prompt_tokens")
  completionTokens  Int              @default(0) @map("completion_tokens")
  latencyMs         Int              @default(0) @map("latency_ms")
  ungroundedNumbers Int              @default(0) @map("ungrounded_numbers")
  createdAt         DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("ai_request_log")
  @@schema("app")
}
