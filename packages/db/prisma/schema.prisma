// Platform tables live in schema "platform", tenant (gym) tables in schema "app".
// Every tenant-owned table in "app" gets a row-level security policy (see migrations) and an entry
// in src/tenant-models.ts. test/registry.test.ts fails if either is missing.
//
// Auth tables follow Better Auth's field names (see packages/auth). The two realms use separate
// tables: PlatformUser/PlatformSession/... (schema platform) and User/Session/... (schema app).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "app"]
}

/// Placeholder from M0; kept so the first migration stays valid.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_check")
  @@schema("platform")
}

// ===================================================================================
// Platform realm: operator accounts (apps/admin)
// ===================================================================================

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT

  @@schema("platform")
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED

  @@schema("platform")
}

model PlatformUser {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false) @map("email_verified")
  image         String?
  role          PlatformRole       @default(SUPPORT)
  status        PlatformUserStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  sessions        PlatformSession[]
  accounts        PlatformAccount[]
  auditLogs       PlatformAuditLog[]
  supportSessions SupportSession[]

  @@map("platform_user")
  @@schema("platform")
}

model PlatformSession {
  id            String    @id @default(uuid()) @db.Uuid
  token         String    @unique
  userId        String    @map("user_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  /// Set when the email OTP second factor passes. Mandatory for every platform user.
  mfaVerifiedAt DateTime? @map("mfa_verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          PlatformUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpChallenges PlatformOtpChallenge[]

  @@index([userId])
  @@map("platform_session")
  @@schema("platform")
}

model PlatformAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_account")
  @@schema("platform")
}

model PlatformVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("platform_verification")
  @@schema("platform")
}

model PlatformOtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  /// HMAC of the code; the code itself is never stored.
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  session PlatformSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("platform_otp_challenge")
  @@schema("platform")
}

// ===================================================================================
// Platform: tenants, plans, entitlements
// ===================================================================================

enum TenantStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CANCELLED

  @@schema("platform")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED

  @@schema("platform")
}

enum FeatureType {
  BOOLEAN
  QUOTA
  CONFIG

  @@schema("platform")
}

enum PlanStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@schema("platform")
}

enum SupportAccessMode {
  READ_ONLY

  @@schema("platform")
}

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique
  legalName    String       @map("legal_name")
  displayName  String       @map("display_name")
  status       TenantStatus @default(ACTIVE)
  statusReason String?      @map("status_reason")
  /// ISO 3166-1 alpha-2.
  country      String       @default("IN")
  timezone     String       @default("Asia/Kolkata")
  /// ISO 4217.
  currency     String       @default("INR")
  locale       String       @default("en-IN")
  approvedAt   DateTime?    @map("approved_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  subscription        TenantSubscription?
  overrides           SubscriptionOverride[]
  usageCounters       UsageCounter[]
  supportSessions     SupportSession[]
  memberships         TenantMembership[]
  roleAssignments     RoleAssignment[]
  branches            Branch[]
  invitations         Invitation[]
  settings            TenantSettings?
  auditLogs           AuditLog[]
  outbox              Outbox[]
  idempotency         IdempotencyRecord[]
  counters            TenantCounter[]
  files               FileRecord[]
  members             MemberProfile[]
  plans               MembershipPlan[]
  coupons             Coupon[]
  invoiceSeries       InvoiceSeries[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  emailTemplates      EmailTemplate[]
  dataJobs            DataJob[]
  classCategories     ClassCategory[]
  ptPackages          PtPackage[]
  paymentIntegrations PaymentIntegration[]
  reconciliationRuns  ReconciliationRun[]
  platformInvoices    PlatformInvoice[]
  platformPayments    PlatformPayment[]
  dunningAttempts     DunningAttempt[]
  leadStages          LeadStage[]
  leadSources         LeadSource[]
  lostReasons         LostReason[]
  campaigns           Campaign[]
  leads               Lead[]
  leadCaptureForms    LeadCaptureForm[]
  apiKeys             TenantApiKey[]
  leadSavedViews      LeadSavedView[]
  eventConsumptions   EventConsumption[]
  whatsappAccounts    WhatsAppAccount[]
  suppressions        SuppressionRecord[]
  segments            Segment[]
  automationWorkflows AutomationWorkflow[]
  retentionRules      RetentionRule[]
  retentionFlags      RetentionFlag[]
  exercises           Exercise[]
  workoutTemplates    WorkoutTemplate[]
  foodItems           FoodItem[]
  gymAnnouncements    GymAnnouncement[]
  achievements        Achievement[]
  challenges          Challenge[]
  rewardRules         RewardRule[]
  rewardPerks         RewardPerk[]
  metricDays          MetricDaily[]
  aiRequests          AiRequestLog[]

  @@index([status])
  @@map("tenant")
  @@schema("platform")
}

model Feature {
  /// e.g. "branches.max", "classes.enabled".
  key          String      @id
  type         FeatureType
  module       String
  description  String
  /// Value when a plan does not list the feature. QUOTA: number, or null = unlimited.
  defaultValue Json?       @map("default_value")
  createdAt    DateTime    @default(now()) @map("created_at")

  planFeatures PlanFeature[]
  overrides    SubscriptionOverride[]

  @@map("feature")
  @@schema("platform")
}

/// Plans are versioned: editing a live plan means creating code@version+1, so existing
/// subscribers keep the terms they signed up for.
model SaasPlan {
  id                String     @id @default(uuid()) @db.Uuid
  code              String
  version           Int
  name              String
  description       String?
  status            PlanStatus @default(DRAFT)
  /// Filled in M4 (SaaS billing).
  priceMonthlyMinor BigInt?    @map("price_monthly_minor")
  currency          String     @default("INR")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions TenantSubscription[]
  prices        SaasPlanPrice[]

  @@unique([code, version])
  @@map("saas_plan")
  @@schema("platform")
}

model PlanFeature {
  planId     String @map("plan_id") @db.Uuid
  featureKey String @map("feature_key")
  /// BOOLEAN: true/false. QUOTA: integer, or null = unlimited. CONFIG: any JSON.
  value      Json?

  plan    SaasPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature  @relation(fields: [featureKey], references: [key])

  @@id([planId, featureKey])
  @@map("plan_feature")
  @@schema("platform")
}

model TenantSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @unique @map("tenant_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?          @map("trial_ends_at")
  /// Filled in M4 (SaaS billing).
  currentPeriodEnd       DateTime?          @map("current_period_end")
  // --- M4: provider subscription and dunning
  currentPeriodStart     DateTime?          @map("current_period_start")
  priceId                String?            @map("price_id") @db.Uuid
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  /// Provider's own status (created, authenticated, active, pending, halted, …).
  providerStatus         String?            @map("provider_status")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  pastDueAt              DateTime?          @map("past_due_at")
  graceEndsAt            DateTime?          @map("grace_ends_at")
  /// Downgrade booked for the end of the period.
  pendingPlanId          String?            @map("pending_plan_id") @db.Uuid
  pendingPriceId         String?            @map("pending_price_id") @db.Uuid
  lastPaymentAt          DateTime?          @map("last_payment_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  plan   SaasPlan       @relation(fields: [planId], references: [id])
  price  SaasPlanPrice? @relation("SubscriptionPrice", fields: [priceId], references: [id])

  @@index([status, trialEndsAt])
  @@map("tenant_subscription")
  @@schema("platform")
}

/// Per-tenant exception to the plan, e.g. 5 extra branches until 31 March.
model SubscriptionOverride {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  featureKey  String    @map("feature_key")
  value       Json?
  reason      String
  expiresAt   DateTime? @map("expires_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  feature Feature @relation(fields: [featureKey], references: [key])

  @@index([tenantId, featureKey])
  @@map("subscription_override")
  @@schema("platform")
}

/// Running totals for QUOTA features, updated in the same transaction as the change they count.
/// The platform admin reads these instead of the tenant's own tables.
model UsageCounter {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("usage_counter")
  @@schema("platform")
}

model PlatformAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  tenantId   String?  @map("tenant_id") @db.Uuid
  before     Json?
  after      Json?
  meta       Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor PlatformUser? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([action])
  @@map("platform_audit_log")
  @@schema("platform")
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_setting")
  @@schema("platform")
}

/// Time-boxed, audited, read-only access by platform support to one tenant.
model SupportSession {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  platformUserId String            @map("platform_user_id") @db.Uuid
  reason         String
  mode           SupportAccessMode @default(READ_ONLY)
  expiresAt      DateTime          @map("expires_at")
  endedAt        DateTime?         @map("ended_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])

  @@index([tenantId, expiresAt])
  @@map("support_session")
  @@schema("platform")
}

// ===================================================================================
// Tenant realm: global identity (no tenant_id, no RLS). One User per email (D-04).
// ===================================================================================

enum UserStatus {
  ACTIVE
  DEACTIVATED

  @@schema("app")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  status        UserStatus @default(ACTIVE)
  deactivatedAt DateTime?  @map("deactivated_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  sessions       Session[]
  accounts       Account[]
  trustedDevices TrustedDevice[]
  memberships    TenantMembership[]

  @@map("user")
  @@schema("app")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  token          String    @unique
  userId         String    @map("user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  /// The tenant the user picked. Re-verified against TenantMembership on every request.
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  activeBranchId String?   @map("active_branch_id") @db.Uuid
  /// Set when the email OTP second factor passes (or a trusted device skips it).
  mfaVerifiedAt  DateTime? @map("mfa_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpChallenges OtpChallenge[]

  @@index([userId])
  @@map("session")
  @@schema("app")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
  @@schema("app")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
  @@schema("app")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  /// HMAC of the code; the code itself is never stored.
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("otp_challenge")
  @@schema("app")
}

/// "Remember this device for 30 days" (staff below administrator only, D-03).
model TrustedDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_device")
  @@schema("app")
}

// ===================================================================================
// Tenant-owned tables (tenant_id + RLS + registry entry)
// ===================================================================================

enum MembershipStatus {
  ACTIVE
  DEACTIVATED

  @@schema("app")
}

enum BranchStatus {
  ACTIVE
  ARCHIVED

  @@schema("app")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@schema("app")
}

enum AuditActorType {
  USER
  SYSTEM
  PLATFORM

  @@schema("app")
}

enum OutboxStatus {
  PENDING
  DONE
  FAILED

  @@schema("app")
}

/// Links a global User to a tenant. Roles hang off it.
model TenantMembership {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  status        MembershipStatus @default(ACTIVE)
  deactivatedAt DateTime?        @map("deactivated_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  roles          RoleAssignment[]
  staffProfile   StaffProfile?
  trainerProfile TrainerProfile?
  availability   StaffAvailability[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("tenant_membership")
  @@schema("app")
}

/// One fixed role (D-07) for a membership. branchId null = every branch.
model RoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  /// A key from packages/auth/src/permissions.ts (TENANT_ROLES). A string so custom roles fit later.
  roleKey      String   @map("role_key")
  branchId     String?  @map("branch_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  // Composite keys: a role can only point at a membership and branch of the same tenant.
  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch?          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, membershipId])
  @@map("role_assignment")
  @@schema("app")
}

model Branch {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  name            String
  /// Short code, unique per tenant, e.g. "JPR-1".
  code            String
  addressLine1    String?      @map("address_line1")
  addressLine2    String?      @map("address_line2")
  city            String?
  /// GST state code, e.g. "08" (Rajasthan).
  stateCode       String       @map("state_code")
  postalCode      String?      @map("postal_code")
  phone           String?
  /// Overrides the tenant timezone when set.
  timezone        String?
  /// Branch's own GSTIN when it is registered separately from the tenant.
  gstin           String?
  status          BranchStatus @default(ACTIVE)
  /// M3: members also check out at this branch (D-09: optional per branch).
  checkoutEnabled Boolean      @default(false) @map("checkout_enabled")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  roleAssignments RoleAssignment[]
  members         MemberProfile[]
  planBranches    PlanBranch[]
  memberships     Membership[]
  invoices        GymInvoice[]
  payments        GymPayment[]
  scanDevices     ScanDevice[]
  attendance      AttendanceEvent[]
  rooms           Room[]
  classTemplates  ClassTemplate[]
  classSessions   ClassSession[]
  ptBalances      PtPackageBalance[]
  ptAppointments  PtAppointment[]
  availability    StaffAvailability[]
  paymentLinks    PaymentLink[]
  leads           Lead[]
  followUpTasks   FollowUpTask[]
  trials          TrialBooking[]
  leadForms       LeadCaptureForm[]
  apiKeys         TenantApiKey[]
  leadCursor      LeadAssignmentCursor[]
  metricDays      MetricDaily[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("branch")
  @@schema("app")
}

model Invitation {
  id                      String           @id @default(uuid()) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  email                   String
  /// [{ roleKey, branchId | null }], validated with Zod in packages/core.
  roles                   Json
  /// SHA-256 of the token in the emailed link.
  tokenHash               String           @unique @map("token_hash")
  status                  InvitationStatus @default(PENDING)
  expiresAt               DateTime         @map("expires_at")
  invitedByUserId         String?          @map("invited_by_user_id") @db.Uuid
  /// Set when the platform admin invited the owner of a platform-created tenant.
  invitedByPlatformUserId String?          @map("invited_by_platform_user_id") @db.Uuid
  acceptedAt              DateTime?        @map("accepted_at")
  acceptedUserId          String?          @map("accepted_user_id") @db.Uuid
  /// Member app invites (M2): accepting links this member profile to the account.
  memberId                String?          @map("member_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("invitation")
  @@schema("app")
}

model TenantSettings {
  tenantId                     String               @id @map("tenant_id") @db.Uuid
  gstRegistered                Boolean              @default(false) @map("gst_registered")
  gstin                        String?
  /// GST state code of the registered business, e.g. "27" (Maharashtra).
  stateCode                    String?              @map("state_code")
  pricesIncludeTax             Boolean              @default(true) @map("prices_include_tax")
  require2faForStaff           Boolean              @default(false) @map("require_2fa_for_staff")
  /// S3 object key of the uploaded logo.
  logoKey                      String?              @map("logo_key")
  // --- M2: billing and membership policies
  /// Up to 4 characters, e.g. "IT" → IT/25-26/00001.
  invoicePrefix                String               @default("INV") @map("invoice_prefix")
  invoiceDueDays               Int                  @default(0) @map("invoice_due_days")
  defaultSacCode               String               @default("999723") @map("default_sac_code")
  placeOfSupplyRule            PlaceOfSupplyRule    @default(BRANCH_STATE) @map("place_of_supply_rule")
  membershipActivation         MembershipActivation @default(FULL_PAYMENT) @map("membership_activation")
  autoApplyCredit              Boolean              @default(true) @map("auto_apply_credit")
  /// Days before expiry to remind members, e.g. {7,3,1}.
  expiryReminderDays           Int[]                @default([7, 3, 1]) @map("expiry_reminder_days")
  memberSelfSignup             Boolean              @default(false) @map("member_self_signup")
  memberJoinApproval           Boolean              @default(true) @map("member_join_approval")
  // --- M3: floor operations
  /// A second check-in within this many minutes is refused as a duplicate.
  checkinDuplicateMinutes      Int                  @default(2) @map("checkin_duplicate_minutes")
  /// What a scan does when the member owes money.
  duesAtCheckin                DuesCheckinPolicy    @default(WARN) @map("dues_at_checkin")
  /// A check-in marks the member's booked classes at that branch today as attended.
  autoMarkClassAttendance      Boolean              @default(true) @map("auto_mark_class_attendance")
  bookingReminderHours         Int                  @default(2) @map("booking_reminder_hours")
  /// Cancelling after the cutoff keeps the class credit used (late cancel).
  lateCancelForfeitsCredit     Boolean              @default(true) @map("late_cancel_forfeits_credit")
  /// A PT no-show uses up a session from the package.
  ptNoShowConsumesSession      Boolean              @default(true) @map("pt_no_show_consumes_session")
  /// PT sessions cancelled closer than this to the start count as no-shows.
  ptCancelCutoffHours          Int                  @default(12) @map("pt_cancel_cutoff_hours")
  // --- M4: online payments, refunds, dues
  /// Payment links expire after this many days.
  paymentLinkExpiryDays        Int                  @default(7) @map("payment_link_expiry_days")
  /// Members may pay part of a balance online; the minimum first part (paise).
  onlinePartialAllowed         Boolean              @default(true) @map("online_partial_allowed")
  onlineMinPartialMinor        BigInt               @default(50000) @map("online_min_partial_minor")
  /// Refunds above this need a second person's approval; null = never.
  refundApprovalThresholdMinor BigInt?              @map("refund_approval_threshold_minor")
  /// Days overdue on which members get a dues reminder.
  duesReminderDays             Int[]                @default([1, 7, 14, 30]) @map("dues_reminder_days")
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")

  tenant                        Tenant             @relation(fields: [tenantId], references: [id])
  // --- M5: CRM
  /// MANUAL, or ROUND_ROBIN among the branch's sales staff.
  leadAssignment                LeadAssignmentMode @default(MANUAL) @map("lead_assignment")
  /// A first-contact task is due this many minutes after a lead arrives.
  leadFirstContactMinutes       Int                @default(15) @map("lead_first_contact_minutes")
  /// Reminder this many minutes before a follow-up task is due.
  taskReminderMinutes           Int                @default(30) @map("task_reminder_minutes")
  // --- M6: messaging
  /// Inbound words that opt a contact out (case-insensitive, whole message).
  optOutKeywords                String[]           @default(["stop", "unsubscribe", "stop all", "cancel", "end", "quit", "opt out", "optout", "band karo", "band", "rok do", "mat bhejo", "nahi chahiye", "बंद", "बंद करो", "रोको"]) @map("opt_out_keywords")
  optInKeywords                 String[]           @default(["start", "subscribe", "shuru", "chalu"]) @map("opt_in_keywords")
  /// Automated marketing messages per member per day (all workflows together).
  marketingDailyCap             Int                @default(1) @map("marketing_daily_cap")
  /// Notification key → {template, language, variables}: which approved template sends it on WhatsApp.
  whatsappNotificationTemplates Json?              @map("whatsapp_notification_templates")
  // --- M7: engagement
  /// A week counts for the streak with at least this many days with a check-in.
  streakVisitsPerWeek           Int                @default(2) @map("streak_visits_per_week")
  /// After a membership expires, the streak survives this many days (then it resets).
  streakGraceDays               Int                @default(14) @map("streak_grace_days")
  /// What one reward point is worth when redeemed as member credit, in paise.
  rewardPointValueMinor         Int                @default(50) @map("reward_point_value_minor")
  rewardMinRedeemPoints         Int                @default(200) @map("reward_min_redeem_points")
  /// Visit points: at most this many rewarded visit days per week (rest days stay rewarded-neutral).
  rewardVisitWeeklyCap          Int                @default(5) @map("reward_visit_weekly_cap")
  // --- M8: KPIs
  /// Renewal / churn / reactivation: a new membership within this many days of the end still counts as a renewal.
  kpiGraceDays                  Int                @default(7) @map("kpi_grace_days")

  @@map("tenant_settings")
  @@schema("app")
}

model AuditLog {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  actorType           AuditActorType @map("actor_type")
  actorUserId         String?        @map("actor_user_id") @db.Uuid
  actorPlatformUserId String?        @map("actor_platform_user_id") @db.Uuid
  action              String
  entityType          String         @map("entity_type")
  entityId            String?        @map("entity_id")
  branchId            String?        @map("branch_id") @db.Uuid
  before              Json?
  after               Json?
  meta                Json?
  ipAddress           String?        @map("ip_address")
  userAgent           String?        @map("user_agent")
  createdAt           DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entityType, entityId])
  @@map("audit_log")
  @@schema("app")
}

/// Transactional outbox: written in the same transaction as the change, delivered by the worker.
model Outbox {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at")
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at")
  processedAt DateTime?    @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([status, availableAt])
  @@map("outbox")
  @@schema("app")
}

/// Remembers the result of a request so a retried request does not run twice.
model IdempotencyRecord {
  tenantId    String   @map("tenant_id") @db.Uuid
  scope       String
  key         String
  requestHash String   @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, scope, key])
  @@map("idempotency_record")
  @@schema("app")
}

