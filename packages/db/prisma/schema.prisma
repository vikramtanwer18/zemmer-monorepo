model FileRecord {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  key              String      @unique
  filename         String
  contentType      String      @map("content_type")
  size             Int
  purpose          FilePurpose
  scanStatus       ScanStatus  @default(PENDING) @map("scan_status")
  uploadedByUserId String?     @map("uploaded_by_user_id") @db.Uuid
  /// Exports and imports are deleted after this.
  expiresAt        DateTime?   @map("expires_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  documents      MemberDocument[]
  memberPhotos   MemberProfile[]        @relation("MemberPhoto")
  certifications TrainerCertification[]

  @@unique([tenantId, id])
  @@index([tenantId, purpose])
  @@map("file_record")
  @@schema("app")
}

model MemberProfile {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  homeBranchId         String       @map("home_branch_id") @db.Uuid
  /// Set once the member has an app account (D-04: global User).
  userId               String?      @map("user_id") @db.Uuid
  /// Human-friendly, unique per tenant, e.g. M-000123.
  memberCode           String       @map("member_code")
  firstName            String       @map("first_name")
  lastName             String?      @map("last_name")
  email                String?
  /// E.164. Collected, not verified in v1 (D-03).
  phone                String?
  phoneVerifiedAt      DateTime?    @map("phone_verified_at")
  dateOfBirth          DateTime?    @map("date_of_birth") @db.Date
  gender               Gender?
  addressLine1         String?      @map("address_line1")
  city                 String?
  /// GST state code, for place-of-supply when the tenant uses MEMBER_STATE.
  stateCode            String?      @map("state_code")
  postalCode           String?      @map("postal_code")
  emergencyName        String?      @map("emergency_name")
  emergencyPhone       String?      @map("emergency_phone")
  /// M3: shown on the digital card and the scan result (visual identity check).
  photoFileId          String?      @map("photo_file_id") @db.Uuid
  /// M4: privacy notice accepted in the member app (version shown).
  privacyAcceptedAt    DateTime?    @map("privacy_accepted_at")
  privacyNoticeVersion String?      @map("privacy_notice_version")
  /// Personal fields wiped on a deletion request; financial records kept (law).
  anonymizedAt         DateTime?    @map("anonymized_at")
  status               MemberStatus @default(ACTIVE)
  source               MemberSource @default(STAFF)
  tags                 String[]     @default([])
  joinedAt             DateTime     @default(now()) @map("joined_at")
  archivedAt           DateTime?    @map("archived_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  homeBranch         Branch                    @relation(fields: [tenantId, homeBranchId], references: [tenantId, id])
  notes              MemberNote[]
  documents          MemberDocument[]
  consents           ContactConsent[]
  memberships        Membership[]
  invoices           GymInvoice[]
  payments           GymPayment[]
  creditEntries      MemberCreditEntry[]
  photo              FileRecord?               @relation("MemberPhoto", fields: [tenantId, photoFileId], references: [tenantId, id])
  passes             MemberPass[]
  attendance         AttendanceEvent[]
  bookings           Booking[]
  waitlist           WaitlistEntry[]
  trainers           TrainerClientAssignment[]
  ptBalances         PtPackageBalance[]
  ptAppointments     PtAppointment[]
  entitlementEntries EntitlementLedger[]
  paymentLinks       PaymentLink[]
  refunds            Refund[]
  dataRequests       MemberDataRequest[]
  convertedLeads     Lead[]                    @relation("LeadConvertedMember")
  followUpTasks      FollowUpTask[]
  conversations      Conversation[]
  // --- M7
  healthConsents     HealthDataConsent[]
  workoutPlans       WorkoutPlan[]
  workoutLogs        WorkoutLog[]
  personalRecords    PersonalRecord[]
  assessments        FitnessAssessment[]
  goals              MemberGoal[]
  nutritionPlans     NutritionPlan[]
  foodLogs           FoodLog[]
  waterLogs          WaterLog[]
  trainerFeedback    TrainerFeedback[]
  streak             StreakState?
  achievements       MemberAchievement[]
  challengeEntries   ChallengeParticipant[]
  rewardEntries      RewardLedger[]
  rewardRedemptions  RewardRedemption[]
  referralCode       ReferralCode?
  referralsMade      Referral[]                @relation("ReferralReferrer")
  referredBy         Referral[]                @relation("ReferralReferred")

  @@unique([tenantId, id])
  @@unique([tenantId, memberCode])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, homeBranchId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("member_profile")
  @@schema("app")
}

model MemberNote {
