model WorkoutLog {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  memberId    String           @map("member_id") @db.Uuid
  planId      String?          @map("plan_id") @db.Uuid
  versionId   String?          @map("version_id") @db.Uuid
  /// Which planned day: "w1d2" (week 1, day 2); null for a free workout.
  dayKey      String?          @map("day_key")
  title       String
  status      WorkoutLogStatus @default(IN_PROGRESS)
  /// Local date it counts for (tenant timezone).
  performedOn DateTime         @map("performed_on") @db.Date
  startedAt   DateTime         @default(now()) @map("started_at")
  completedAt DateTime?        @map("completed_at")
  /// Perceived effort 1–10 (member's own rating).
  effort      Int?
  notes       String?
  createdById String?          @map("created_by_id") @db.Uuid
  updatedAt   DateTime         @updatedAt @map("updated_at")

  member  MemberProfile       @relation(fields: [tenantId, memberId], references: [tenantId, id])
  plan    WorkoutPlan?        @relation(fields: [tenantId, planId], references: [tenantId, id])
  version WorkoutPlanVersion? @relation(fields: [tenantId, versionId], references: [tenantId, id])
  sets    SetLog[]
  records PersonalRecord[]

  @@unique([tenantId, id])
  @@index([tenantId, memberId, performedOn])
  @@map("workout_log")
  @@schema("app")
}

model SetLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  logId       String   @map("log_id") @db.Uuid
  exerciseId  String   @map("exercise_id") @db.Uuid
