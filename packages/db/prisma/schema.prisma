/// A gym's own WhatsApp Business Account + phone number (D-12). The token is envelope-encrypted.
model WhatsAppAccount {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  wabaId            String                   @map("waba_id")
  phoneNumberId     String                   @map("phone_number_id")
  displayPhone      String?                  @map("display_phone")
  verifiedName      String?                  @map("verified_name")
  accessTokenEnc    String                   @map("access_token_enc")
  tokenLast4        String                   @map("token_last4")
  connectionMethod  WhatsAppConnectionMethod @map("connection_method")
  status            WhatsAppAccountStatus    @default(ACTIVE)
  qualityRating     String?                  @map("quality_rating")
  messagingLimit    String?                  @map("messaging_limit")
  webhookSubscribed Boolean                  @default(false) @map("webhook_subscribed")
  lastSyncedAt      DateTime?                @map("last_synced_at")
  lastError         String?                  @map("last_error")
  connectedById     String?                  @map("connected_by_id") @db.Uuid
  disconnectedAt    DateTime?                @map("disconnected_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  templates     MessageTemplate[]
  conversations Conversation[]
  outbound      OutboundMessage[]
  events        MessageEvent[]

  @@unique([tenantId, id])
  @@index([phoneNumberId])
  @@index([wabaId])
  @@map("whatsapp_account")
  @@schema("app")
}

/// Templates synced from Meta (read-only copies; edited in Meta's manager).
model MessageTemplate {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  accountId          String           @map("account_id") @db.Uuid
  providerTemplateId String?          @map("provider_template_id")
  name               String
  language           String
  category           TemplateCategory
  /// Meta's status: APPROVED, PENDING, REJECTED, PAUSED, DISABLED, …
  status             String
  parameterFormat    String           @default("POSITIONAL") @map("parameter_format")
  /// Placeholder names in body order: ["1","2"] or ["first_name", …].
  variables          String[]         @default([])
  bodyText           String?          @map("body_text")
  components         Json
  syncedAt           DateTime         @map("synced_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  account  WhatsAppAccount   @relation(fields: [tenantId, accountId], references: [tenantId, id])
  outbound OutboundMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, accountId, name, language])
  @@map("message_template")
  @@schema("app")
}

/// Never contact this address on this channel (opt-out keyword, block, bounce, staff). Applies to
/// every future send, checked at send time.
model SuppressionRecord {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  channel     ConsentChannel
  /// E.164 phone or lower-case email.
  address     String
  reason      SuppressionReason
  note        String?
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  liftedAt    DateTime?         @map("lifted_at")
  liftedById  String?           @map("lifted_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, channel, address])
  @@map("suppression_record")
  @@schema("app")
}

/// One WhatsApp thread per phone number per account (minimal inbox).
model Conversation {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  phone          String
  profileName    String?   @map("profile_name")
  memberId       String?   @map("member_id") @db.Uuid
  leadId         String?   @map("lead_id") @db.Uuid
  assigneeUserId String?   @map("assignee_user_id") @db.Uuid
  /// The 24-hour customer service window runs from the last inbound message.
  lastInboundAt  DateTime? @map("last_inbound_at")
  lastMessageAt  DateTime? @map("last_message_at")
  unread         Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  account  WhatsAppAccount   @relation(fields: [tenantId, accountId], references: [tenantId, id])
  member   MemberProfile?    @relation(fields: [tenantId, memberId], references: [tenantId, id])
  lead     Lead?             @relation(fields: [tenantId, leadId], references: [tenantId, id])
  inbound  InboundMessage[]
  outbound OutboundMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, accountId, phone])
  @@index([tenantId, lastMessageAt])
  @@map("conversation")
  @@schema("app")
}

model InboundMessage {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  providerMessageId String   @map("provider_message_id")
  type              String
  text              String?
  receivedAt        DateTime @map("received_at")
  /// Opt-out / opt-in keyword it matched, if any.
  keyword           String?
  createdAt         DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id])

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, conversationId, receivedAt])
  @@map("inbound_message")
  @@schema("app")
}

/// Every WhatsApp send (campaign, automation, notification, inbox reply, test). Idempotent per key.
model OutboundMessage {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  accountId         String           @map("account_id") @db.Uuid
  conversationId    String?          @map("conversation_id") @db.Uuid
  /// e.g. "campaign:<recipientId>", "auto:<executionId>:<step>", "notif:<dedupeKey>".
  idempotencyKey    String           @map("idempotency_key")
  toPhone           String           @map("to_phone")
  memberId          String?          @map("member_id") @db.Uuid
  leadId            String?          @map("lead_id") @db.Uuid
  kind              MessageKind
  templateId        String?          @map("template_id") @db.Uuid
  templateName      String?          @map("template_name")
  language          String?
  /// Values for the template placeholders, in order or by name.
  variables         Json?
  /// Rendered preview (template body with values, or the free text).
  body              String?
  category          TemplateCategory
  purpose           MessagePurpose
  status            OutboundStatus   @default(QUEUED)
  skipReason        String?          @map("skip_reason")
  providerMessageId String?          @map("provider_message_id")
  errorCode         String?          @map("error_code")
  errorMessage      String?          @map("error_message")
  attempts          Int              @default(0)
  pricingCategory   String?          @map("pricing_category")
  campaignId        String?          @map("campaign_id") @db.Uuid
  executionId       String?          @map("execution_id") @db.Uuid
  createdById       String?          @map("created_by_id") @db.Uuid
  queuedAt          DateTime         @default(now()) @map("queued_at")
  sentAt            DateTime?        @map("sent_at")
  deliveredAt       DateTime?        @map("delivered_at")
  readAt            DateTime?        @map("read_at")
  failedAt          DateTime?        @map("failed_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  account      WhatsAppAccount     @relation(fields: [tenantId, accountId], references: [tenantId, id])
  conversation Conversation?       @relation(fields: [tenantId, conversationId], references: [tenantId, id])
  template     MessageTemplate?    @relation(fields: [tenantId, templateId], references: [tenantId, id])
  recipients   CampaignRecipient[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, providerMessageId])
  @@index([tenantId, status, queuedAt])
  @@index([tenantId, memberId, queuedAt])
  @@index([tenantId, campaignId])
  @@map("outbound_message")
  @@schema("app")
}

/// Verified Meta webhook items for this tenant, stored once (dedupe key), processed by the worker.
model MessageEvent {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  accountId   String             @map("account_id") @db.Uuid
  kind        MessageEventKind
  /// "status:<wamid>:<status>", "inbound:<wamid>", "template:<id>:<status>:<ts>".
  dedupeKey   String             @map("dedupe_key")
  payload     Json
  status      MessageEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  error       String?
  receivedAt  DateTime           @default(now()) @map("received_at")
  processedAt DateTime?          @map("processed_at")

  account WhatsAppAccount @relation(fields: [tenantId, accountId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, receivedAt])
  @@map("message_event")
  @@schema("app")
}

/// A saved audience: validated filter DSL over whitelisted fields (never SQL).
model Segment {
