  BOOKING
  BOOKING_RETURNED
  SESSION_COMPLETED
  SESSION_NO_SHOW
  ADJUSTMENT
  EXPIRED

  @@schema("app")
}

/// The member's digital pass. The QR shows passId.timeStep.mac (packages/core/src/attendance/pass-code.ts).
model MemberPass {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  memberId        String     @map("member_id") @db.Uuid
  /// Opaque random id printed in the QR (no personal data). Unique across tenants.
  passId          String     @unique @map("pass_id")
  /// 32 random bytes sealed with the data-encryption key (packages/core/src/crypto).
  secretEncrypted String     @map("secret_encrypted")
  status          PassStatus @default(ACTIVE)
  issuedAt        DateTime   @default(now()) @map("issued_at")
  issuedById      String?    @map("issued_by_id") @db.Uuid
  revokedAt       DateTime?  @map("revoked_at")
  revokedById     String?    @map("revoked_by_id") @db.Uuid
  revokedReason   String?    @map("revoked_reason")

  member MemberProfile @relation(fields: [tenantId, memberId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, memberId])
  @@map("member_pass")
  @@schema("app")
}

/// A named scanner (reception tablet, phone) at a branch. Optional: scans also work without one.
model ScanDevice {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  branchId    String       @map("branch_id") @db.Uuid
  name        String
  status      RecordStatus @default(ACTIVE)
  lastSeenAt  DateTime?    @map("last_seen_at")
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  branch Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id])
  events AttendanceEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, name])
  @@map("scan_device")
  @@schema("app")
}

/// Every scan (accepted or rejected) and every manual check-in or check-out. Never deleted:
/// corrections void a record or move its time, with a reason, and are audited.
model AttendanceEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  branchId           String           @map("branch_id") @db.Uuid
  /// Null when the scanned pass is unknown.
  memberId           String?          @map("member_id") @db.Uuid
  type               AttendanceType   @default(CHECK_IN)
  method             AttendanceMethod
  result             AttendanceResult
  /// Why a scan was refused, e.g. CODE_ALREADY_USED, MEMBERSHIP_EXPIRED.
  rejectCode         String?          @map("reject_code")
  passId             String?          @map("pass_id")
  timeStep           Int?             @map("time_step")
  scannedByUserId    String?          @map("scanned_by_user_id") @db.Uuid
  deviceId           String?          @map("device_id") @db.Uuid
  /// Required for manual check-ins, overrides and corrections.
  reason             String?
  /// Checked in although a rule refused it (attendance.override).
  overridden         Boolean          @default(false)
  occurredAt         DateTime         @default(now()) @map("occurred_at")
  originalOccurredAt DateTime?        @map("original_occurred_at")
  correctedAt        DateTime?        @map("corrected_at")
  correctedById      String?          @map("corrected_by_id") @db.Uuid
  voidedAt           DateTime?        @map("voided_at")
  voidedById         String?          @map("voided_by_id") @db.Uuid
  voidReason         String?          @map("void_reason")
  createdAt          DateTime         @default(now()) @map("created_at")

  branch Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id])
  member MemberProfile? @relation(fields: [tenantId, memberId], references: [tenantId, id])
  device ScanDevice?    @relation(fields: [tenantId, deviceId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, branchId, occurredAt])
  @@index([tenantId, memberId, occurredAt])
  @@map("attendance_event")
  @@schema("app")
}

model ClassCategory {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  /// Hex colour for the calendar.
  color     String       @default("#204289")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  templates ClassTemplate[]
  sessions  ClassSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("class_category")
  @@schema("app")
}

model Room {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  branchId  String       @map("branch_id") @db.Uuid
  name      String
  capacity  Int?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  branch    Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  templates ClassTemplate[]
  sessions  ClassSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, name])
  @@map("room")
  @@schema("app")
}

/// A recurring class. Sessions are materialized 8 weeks ahead by the worker.
/// Recurrence is a weekly RRULE subset: BYDAY days, from startDate, until untilDate or COUNT.
model ClassTemplate {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  branchId             String       @map("branch_id") @db.Uuid
  categoryId           String?      @map("category_id") @db.Uuid
  name                 String
  description          String?
  trainerId            String?      @map("trainer_id") @db.Uuid
  roomId               String?      @map("room_id") @db.Uuid
  capacity             Int
  durationMinutes      Int          @map("duration_minutes")
  /// Minutes after local midnight (branch timezone), e.g. 390 = 06:30.
  startMinute          Int          @map("start_minute")
  /// ISO weekdays 1 (Monday) .. 7 (Sunday).
  byDays               Int[]        @map("by_days")
  startDate            DateTime     @map("start_date") @db.Date
  untilDate            DateTime?    @map("until_date") @db.Date
  occurrenceCount      Int?         @map("occurrence_count")
  /// Plan codes allowed to book; empty = any active membership.
  eligiblePlanCodes    String[]     @default([]) @map("eligible_plan_codes")
  bookingOpensHours    Int          @default(168) @map("booking_opens_hours")
  bookingClosesMinutes Int          @default(0) @map("booking_closes_minutes")
  cancelCutoffMinutes  Int          @default(120) @map("cancel_cutoff_minutes")
  waitlistEnabled      Boolean      @default(true) @map("waitlist_enabled")
  waitlistMax          Int?         @map("waitlist_max")
  status               RecordStatus @default(ACTIVE)
  /// Bumped on every change; sessions remember the version they were built from.
  version              Int          @default(1)
  createdById          String?      @map("created_by_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  branch   Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  category ClassCategory?  @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  trainer  TrainerProfile? @relation(fields: [tenantId, trainerId], references: [tenantId, id])
  room     Room?           @relation(fields: [tenantId, roomId], references: [tenantId, id])
  sessions ClassSession[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
  @@map("class_template")
  @@schema("app")
}

/// One occurrence of a class (from a template, or a one-off). bookedCount is changed only by
/// the conditional update in the booking service, never read-modify-write.
model ClassSession {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  branchId             String             @map("branch_id") @db.Uuid
  templateId           String?            @map("template_id") @db.Uuid
  templateVersion      Int?               @map("template_version")
  /// Local date of the occurrence; with templateId it makes materialization idempotent.
  occurrenceDate       DateTime?          @map("occurrence_date") @db.Date
  categoryId           String?            @map("category_id") @db.Uuid
  name                 String
  trainerId            String?            @map("trainer_id") @db.Uuid
  roomId               String?            @map("room_id") @db.Uuid
  startsAt             DateTime           @map("starts_at")
  endsAt               DateTime           @map("ends_at")
  capacity             Int
  bookedCount          Int                @default(0) @map("booked_count")
  eligiblePlanCodes    String[]           @default([]) @map("eligible_plan_codes")
  bookingOpensHours    Int                @map("booking_opens_hours")
  bookingClosesMinutes Int                @map("booking_closes_minutes")
  cancelCutoffMinutes  Int                @map("cancel_cutoff_minutes")
  waitlistEnabled      Boolean            @map("waitlist_enabled")
  waitlistMax          Int?               @map("waitlist_max")
  status               ClassSessionStatus @default(SCHEDULED)
  /// Set when a template change could not be applied because the session has bookings.
  conflictNote         String?            @map("conflict_note")
  reminderSentAt       DateTime?          @map("reminder_sent_at")
  cancelledAt          DateTime?          @map("cancelled_at")
  cancelledById        String?            @map("cancelled_by_id") @db.Uuid
  cancelReason         String?            @map("cancel_reason")
  completedAt          DateTime?          @map("completed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  branch   Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  template ClassTemplate?  @relation(fields: [tenantId, templateId], references: [tenantId, id])
  category ClassCategory?  @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  trainer  TrainerProfile? @relation(fields: [tenantId, trainerId], references: [tenantId, id])
  room     Room?           @relation(fields: [tenantId, roomId], references: [tenantId, id])
  bookings Booking[]
  waitlist WaitlistEntry[]
  trials   TrialBooking[]

  @@unique([tenantId, id])
  @@unique([tenantId, templateId, occurrenceDate])
  @@index([tenantId, branchId, startsAt])
  @@index([tenantId, trainerId, startsAt])
  @@index([tenantId, status, endsAt])
  @@map("class_session")
  @@schema("app")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  sessionId      String        @map("session_id") @db.Uuid
  memberId       String        @map("member_id") @db.Uuid
  /// The membership that allowed the booking (and paid the credit, if the plan uses credits).
  membershipId   String?       @map("membership_id") @db.Uuid
  status         BookingStatus @default(BOOKED)
  source         BookingSource
  usedCredit     Boolean       @default(false) @map("used_credit")
  /// Cancelled after the cancellation cutoff.
  lateCancel     Boolean       @default(false) @map("late_cancel")
  bookedById     String?       @map("booked_by_id") @db.Uuid
  cancelledAt    DateTime?     @map("cancelled_at")
  cancelledById  String?       @map("cancelled_by_id") @db.Uuid
  cancelReason   String?       @map("cancel_reason")
  markedAt       DateTime?     @map("marked_at")
  markedById     String?       @map("marked_by_id") @db.Uuid
  reminderSentAt DateTime?     @map("reminder_sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  session    ClassSession  @relation(fields: [tenantId, sessionId], references: [tenantId, id])
  member     MemberProfile @relation(fields: [tenantId, memberId], references: [tenantId, id])
  membership Membership?   @relation(fields: [tenantId, membershipId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, sessionId, status])
  @@index([tenantId, memberId, createdAt])
  @@map("booking")
  @@schema("app")
}

model WaitlistEntry {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  sessionId   String         @map("session_id") @db.Uuid
  memberId    String         @map("member_id") @db.Uuid
  /// 1, 2, 3 … in joining order; promotion takes the lowest WAITING position.
  position    Int
  status      WaitlistStatus @default(WAITING)
  bookingId   String?        @map("booking_id") @db.Uuid
  /// Why an entry was skipped (no credit, membership ended).
  note        String?
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  session ClassSession  @relation(fields: [tenantId, sessionId], references: [tenantId, id])
  member  MemberProfile @relation(fields: [tenantId, memberId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, position])
  @@map("waitlist_entry")
  @@schema("app")
}

/// Staff details beyond the M1 account and roles. Pay fields need staff.compensation.view.
model StaffProfile {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  phone          String?
  jobTitle       String?         @map("job_title")
  employmentType EmploymentType? @map("employment_type")
  startDate      DateTime?       @map("start_date") @db.Date
  emergencyName  String?         @map("emergency_name")
  emergencyPhone String?         @map("emergency_phone")
  payBasis       PayBasis?       @map("pay_basis")
  payRateMinor   BigInt?         @map("pay_rate_minor")
  payNotes       String?         @map("pay_notes")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId])

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("staff_profile")
  @@schema("app")
}

model TrainerProfile {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  displayName      String       @map("display_name")
  specialties      String[]     @default([])
  bio              String?
  /// Shown to members in the class schedule and PT booking.
  visibleToMembers Boolean      @default(true) @map("visible_to_members")
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  membership     TenantMembership          @relation(fields: [tenantId, userId], references: [tenantId, userId])
  certifications TrainerCertification[]
  templates      ClassTemplate[]
  sessions       ClassSession[]
  clients        TrainerClientAssignment[]
  ptBalances     PtPackageBalance[]
  appointments   PtAppointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("trainer_profile")
  @@schema("app")
}

model TrainerCertification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  trainerId String    @map("trainer_id") @db.Uuid
  title     String
  issuer    String?
  issuedOn  DateTime? @map("issued_on") @db.Date
  expiresOn DateTime? @map("expires_on") @db.Date
  fileId    String?   @map("file_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  trainer TrainerProfile @relation(fields: [tenantId, trainerId], references: [tenantId, id], onDelete: Cascade)
  file    FileRecord?    @relation(fields: [tenantId, fileId], references: [tenantId, id])

  @@index([tenantId, trainerId])
  @@map("trainer_certification")
  @@schema("app")
}

/// Weekly working hours and dated exceptions (leave, extra hours), in the branch's local time.
model StaffAvailability {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  branchId    String?          @map("branch_id") @db.Uuid
  kind        AvailabilityKind
  /// WEEKLY: ISO weekday 1..7.
  dayOfWeek   Int?             @map("day_of_week")
  /// EXCEPTION: the local date.
  date        DateTime?        @db.Date
  /// Minutes after local midnight; [startMinute, endMinute).
  startMinute Int              @map("start_minute")
  endMinute   Int              @map("end_minute")
  /// EXCEPTION only: false = not available (leave), true = extra hours.
  available   Boolean          @default(true)
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at")

  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  branch     Branch?          @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@index([tenantId, userId, kind])
  @@map("staff_availability")
  @@schema("app")
}

/// Trainer ↔ member, with history (ended rows stay).
model TrainerClientAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  trainerId    String    @map("trainer_id") @db.Uuid
  memberId     String    @map("member_id") @db.Uuid
  note         String?
  startedAt    DateTime  @default(now()) @map("started_at")
  assignedById String?   @map("assigned_by_id") @db.Uuid
  endedAt      DateTime? @map("ended_at")
  endedById    String?   @map("ended_by_id") @db.Uuid
  endReason    String?   @map("end_reason")

  trainer TrainerProfile @relation(fields: [tenantId, trainerId], references: [tenantId, id])
  member  MemberProfile  @relation(fields: [tenantId, memberId], references: [tenantId, id])

  @@index([tenantId, trainerId])
  @@index([tenantId, memberId])
  @@map("trainer_client_assignment")
  @@schema("app")
}

/// A personal-training package for sale (like a plan). Sold packages keep their own copy of the terms.
model PtPackage {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  code           String
  name           String
  description    String?
  sessionCount   Int          @map("session_count")
  validityDays   Int          @map("validity_days")
  sessionMinutes Int          @default(60) @map("session_minutes")
  priceMinor     BigInt       @map("price_minor")
  currency       String       @default("INR")
  taxRateBps     Int          @default(1800) @map("tax_rate_bps")
  sacCode        String       @default("999723") @map("sac_code")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  balances PtPackageBalance[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("pt_package")
  @@schema("app")
}

/// A sold PT package. Sessions left = the EntitlementLedger sum for this balance.
model PtPackageBalance {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  memberId       String          @map("member_id") @db.Uuid
  packageId      String          @map("package_id") @db.Uuid
  branchId       String          @map("branch_id") @db.Uuid
  invoiceId      String?         @map("invoice_id") @db.Uuid
  /// Preferred trainer, if one was chosen at sale.
  trainerId      String?         @map("trainer_id") @db.Uuid
  name           String
  sessionsTotal  Int             @map("sessions_total")
  sessionMinutes Int             @map("session_minutes")
  validityDays   Int             @map("validity_days")
  status         PtBalanceStatus @default(PENDING_PAYMENT)
  activatedAt    DateTime?       @map("activated_at")
  /// Last local date sessions can be used (set on activation).
  expiresOn      DateTime?       @map("expires_on") @db.Date
  cancelledAt    DateTime?       @map("cancelled_at")
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  member       MemberProfile       @relation(fields: [tenantId, memberId], references: [tenantId, id])
  package      PtPackage           @relation(fields: [tenantId, packageId], references: [tenantId, id])
  branch       Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id])
  invoice      GymInvoice?         @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  trainer      TrainerProfile?     @relation(fields: [tenantId, trainerId], references: [tenantId, id])
  appointments PtAppointment[]
  entries      EntitlementLedger[]

  @@unique([tenantId, id])
  @@index([tenantId, memberId])
  @@index([tenantId, invoiceId])
  @@map("pt_package_balance")
  @@schema("app")
}

model PtAppointment {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  branchId      String              @map("branch_id") @db.Uuid
  trainerId     String              @map("trainer_id") @db.Uuid
  memberId      String              @map("member_id") @db.Uuid
  balanceId     String              @map("balance_id") @db.Uuid
  startsAt      DateTime            @map("starts_at")
  endsAt        DateTime            @map("ends_at")
  status        PtAppointmentStatus @default(SCHEDULED)
  /// Trainer notes (no health data until the M7 health-data consent exists).
  notes         String?
  createdById   String?             @map("created_by_id") @db.Uuid
  markedAt      DateTime?           @map("marked_at")
  markedById    String?             @map("marked_by_id") @db.Uuid
  cancelledAt   DateTime?           @map("cancelled_at")
  cancelledById String?             @map("cancelled_by_id") @db.Uuid
  cancelReason  String?             @map("cancel_reason")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  branch  Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id])
  trainer TrainerProfile   @relation(fields: [tenantId, trainerId], references: [tenantId, id])
  member  MemberProfile    @relation(fields: [tenantId, memberId], references: [tenantId, id])
  balance PtPackageBalance @relation(fields: [tenantId, balanceId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, trainerId, startsAt])
  @@index([tenantId, memberId, startsAt])
  @@map("pt_appointment")
  @@schema("app")
}

/// Class credits and PT sessions, granted and used. Append-only; a balance is always a sum.
model EntitlementLedger {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  memberId      String            @map("member_id") @db.Uuid
  kind          EntitlementKind
  /// CLASS_CREDIT: the membership whose plan grants the credits.
  membershipId  String?           @map("membership_id") @db.Uuid
  /// PT_SESSION: the package balance.
  ptBalanceId   String?           @map("pt_balance_id") @db.Uuid
  /// Positive grants, negative uses.
  delta         Int
  reason        EntitlementReason
  bookingId     String?           @map("booking_id") @db.Uuid
  appointmentId String?           @map("appointment_id") @db.Uuid
  note          String?
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  member     MemberProfile     @relation(fields: [tenantId, memberId], references: [tenantId, id])
  membership Membership?       @relation(fields: [tenantId, membershipId], references: [tenantId, id])
  ptBalance  PtPackageBalance? @relation(fields: [tenantId, ptBalanceId], references: [tenantId, id])

  @@index([tenantId, membershipId])
  @@index([tenantId, ptBalanceId])
  @@index([tenantId, memberId, kind])
  @@map("entitlement_ledger")
  @@schema("app")
}

// ===================================================================================
// M4: gym online payments (D-10) — tenant-owned, schema "app"
// ===================================================================================

enum PaymentProviderKind {
  RAZORPAY
  /// Development and tests only (PAYMENTS_FAKE_ENABLED); never in production.
  FAKE

  @@schema("app")
}

enum PaymentMode {
  TEST
  LIVE

  @@schema("app")
}

enum IntegrationStatus {
  ACTIVE
  DISCONNECTED

  @@schema("app")
}

enum PaymentLinkStatus {
  CREATED
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED

  @@schema("app")
}

enum PaymentLinkPurpose {
  /// Staff sent it for chosen invoices.
  INVOICES
  /// Member paid their balance in the app.
  BALANCE
  /// Member renewed in the app.
  RENEWAL
  /// Member bought a plan in the app.
  PURCHASE

  @@schema("app")
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED

  @@schema("app")
}

enum RefundKind {
  ONLINE
  MANUAL

  @@schema("app")
}

enum RefundStatus {
  PENDING_APPROVAL
  PENDING
  PROCESSED
  FAILED
  REJECTED

  @@schema("app")
}

enum ReconciliationKind {
  QUICK
  DAILY
  MANUAL

  @@schema("app")
}

enum ReconciliationItemStatus {
  OPEN
  RESOLVED

  @@schema("app")
}

enum DataRequestKind {
  EXPORT
  DELETION

  @@schema("app")
}

enum DataRequestStatus {
  OPEN
  DONE
  REJECTED

  @@schema("app")
}

/// A gym's own Razorpay account (D-10). Secrets sealed with DATA_ENCRYPTION_KEY, never sent to
/// the browser; only the last 4 characters of the key secret are shown.
model PaymentIntegration {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  provider         PaymentProviderKind
  mode             PaymentMode
  keyId            String              @map("key_id")
  keySecretEnc     String              @map("key_secret_enc")
  webhookSecretEnc String              @map("webhook_secret_enc")
  secretLast4      String              @map("secret_last4")
  status           IntegrationStatus   @default(ACTIVE)
  lastVerifiedAt   DateTime?           @map("last_verified_at")
  connectedById    String?             @map("connected_by_id") @db.Uuid
  disconnectedAt   DateTime?           @map("disconnected_at")
  disconnectedById String?             @map("disconnected_by_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  links    PaymentLink[]
  webhooks WebhookEvent[]

  @@unique([tenantId, id])
  @@map("payment_integration")
  @@schema("app")
}

model PaymentLink {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  integrationId   String             @map("integration_id") @db.Uuid
  memberId        String             @map("member_id") @db.Uuid
  branchId        String             @map("branch_id") @db.Uuid
  /// Our id sent to the provider (≤ 40 chars); the provider refuses a second link with it.
  referenceId     String             @unique @map("reference_id")
  providerLinkId  String?            @map("provider_link_id")
  purpose         PaymentLinkPurpose
  amountMinor     BigInt             @map("amount_minor")
  amountPaidMinor BigInt             @default(0) @map("amount_paid_minor")
  currency        String             @default("INR")
  acceptPartial   Boolean            @map("accept_partial")
  minPartialMinor BigInt?            @map("min_partial_minor")
  status          PaymentLinkStatus  @default(CREATED)
  shortUrl        String?            @map("short_url")
  expiresAt       DateTime?          @map("expires_at")
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  cancelledAt     DateTime?          @map("cancelled_at")
  lastSyncedAt    DateTime?          @map("last_synced_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  integration PaymentIntegration   @relation(fields: [tenantId, integrationId], references: [tenantId, id])
  member      MemberProfile        @relation(fields: [tenantId, memberId], references: [tenantId, id])
  branch      Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id])
  invoices    PaymentLinkInvoice[]
  payments    GymPayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, providerLinkId])
  @@index([tenantId, status])
  @@index([tenantId, memberId])
  @@map("payment_link")
  @@schema("app")
}

/// Which invoices a link pays, in allocation order.
model PaymentLinkInvoice {
  tenantId  String @map("tenant_id") @db.Uuid
  linkId    String @map("link_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  position  Int

  link    PaymentLink @relation(fields: [tenantId, linkId], references: [tenantId, id], onDelete: Cascade)
  invoice GymInvoice  @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@id([tenantId, linkId, invoiceId])
  @@map("payment_link_invoice")
  @@schema("app")
}

/// Every verified webhook, deduplicated by the provider's event id. Payloads are redacted.
/// Forged (unsigned) requests are never written here.
model WebhookEvent {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  integrationId String        @map("integration_id") @db.Uuid
  eventId       String        @map("event_id")
  type          String
  payload       Json
  status        WebhookStatus @default(RECEIVED)
  attempts      Int           @default(0)
  error         String?
  receivedAt    DateTime      @default(now()) @map("received_at")
  processedAt   DateTime?     @map("processed_at")

  integration PaymentIntegration @relation(fields: [tenantId, integrationId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([integrationId, eventId])
  @@index([tenantId, status, receivedAt])
  @@map("webhook_event")
  @@schema("app")
}

model Refund {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  paymentId        String         @map("payment_id") @db.Uuid
  memberId         String         @map("member_id") @db.Uuid
  kind             RefundKind
  amountMinor      BigInt         @map("amount_minor")
  reason           String
  status           RefundStatus
  /// MANUAL: how the money was handed back.
  method           PaymentMethod?
  reference        String?
  /// Our idempotency key at the provider (Razorpay `receipt`).
  receipt          String         @unique
  providerRefundId String?        @map("provider_refund_id")
  creditNoteIds    String[]       @default([]) @map("credit_note_ids")
  cancelMembership Boolean        @default(false) @map("cancel_membership")
  requestedById    String?        @map("requested_by_id") @db.Uuid
  approvedById     String?        @map("approved_by_id") @db.Uuid
  decidedAt        DateTime?      @map("decided_at")
  failureReason    String?        @map("failure_reason")
  processedAt      DateTime?      @map("processed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  payment GymPayment    @relation(fields: [tenantId, paymentId], references: [tenantId, id])
  member  MemberProfile @relation(fields: [tenantId, memberId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, paymentId])
  @@index([tenantId, processedAt])
  @@map("refund")
  @@schema("app")
}

model ReconciliationRun {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  kind       ReconciliationKind
  startedAt  DateTime           @default(now()) @map("started_at")
  finishedAt DateTime?          @map("finished_at")
  checked    Int                @default(0)
  fixed      Int                @default(0)
  mismatches Int                @default(0)
  error      String?

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  items  ReconciliationItem[]

  @@unique([tenantId, id])
  @@index([tenantId, startedAt])
  @@map("reconciliation_run")
  @@schema("app")
}

model ReconciliationItem {
  id           String                   @id @default(uuid()) @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  runId        String                   @map("run_id") @db.Uuid
  /// LINK, PAYMENT or REFUND.
  entity       String
  entityId     String                   @map("entity_id") @db.Uuid
  providerId   String?                  @map("provider_id")
  issue        String
  detail       Json?
  status       ReconciliationItemStatus @default(OPEN)
  resolvedAt   DateTime?                @map("resolved_at")
  resolvedById String?                  @map("resolved_by_id") @db.Uuid
  createdAt    DateTime                 @default(now()) @map("created_at")

  run ReconciliationRun @relation(fields: [tenantId, runId], references: [tenantId, id])

  @@index([tenantId, status])
  @@map("reconciliation_item")
  @@schema("app")
}

/// Member privacy requests (M4 launch minimum): data export and deletion (anonymisation).
model MemberDataRequest {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  memberId    String            @map("member_id") @db.Uuid
  kind        DataRequestKind
  status      DataRequestStatus @default(OPEN)
  note        String?
  handledById String?           @map("handled_by_id") @db.Uuid
  handledAt   DateTime?         @map("handled_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  member MemberProfile @relation(fields: [tenantId, memberId], references: [tenantId, id])

  @@index([tenantId, status])
  @@map("member_data_request")
  @@schema("app")
}

// ===================================================================================
// M4: SaaS billing (platform) — schema "platform", never touched by gym_app except reads
// of public catalogue data and its own subscription row.
// ===================================================================================

enum BillingCycle {
  MONTHLY
  HALF_YEARLY
  YEARLY

  @@schema("platform")
}

enum PlatformInvoiceStatus {
  ISSUED
  PAID
  VOID

  @@schema("platform")
}

enum PlatformWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED

  @@schema("platform")
}

enum AnnouncementAudience {
  ALL
  PLANS
  STATUSES

  @@schema("platform")
}

/// Price of a plan version per billing cycle, mapped to the provider's plan id.
model SaasPlanPrice {
  id             String       @id @default(uuid()) @db.Uuid
  planId         String       @map("plan_id") @db.Uuid
  cycle          BillingCycle
  amountMinor    BigInt       @map("amount_minor")
  currency       String       @default("INR")
  providerPlanId String?      @map("provider_plan_id")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")

  plan          SaasPlan             @relation(fields: [planId], references: [id])
  subscriptions TenantSubscription[] @relation("SubscriptionPrice")

  @@unique([planId, cycle])
  @@map("saas_plan_price")
  @@schema("platform")
}

/// The operator's own Razorpay account for SaaS billing. Readable only by gym_platform.
model PlatformPaymentAccount {
  id               String    @id @default(uuid()) @db.Uuid
  /// RAZORPAY or FAKE (plain text: platform tables can't use app-schema enums).
  provider         String
  /// TEST or LIVE.
  mode             String
  keyId            String    @map("key_id")
  keySecretEnc     String    @map("key_secret_enc")
  webhookSecretEnc String    @map("webhook_secret_enc")
  secretLast4      String    @map("secret_last4")
  active           Boolean   @default(true)
  lastVerifiedAt   DateTime? @map("last_verified_at")
  updatedById      String?   @map("updated_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("platform_payment_account")
  @@schema("platform")
}

model PlatformInvoice {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  number            String                @unique
  issueDate         DateTime              @map("issue_date") @db.Date
  periodStart       DateTime?             @map("period_start")
  periodEnd         DateTime?             @map("period_end")
  description       String
  /// Operator (supplier) and gym (recipient, B2B with GSTIN when registered) snapshots.
  supplier          Json
  recipient         Json
  taxableMinor      BigInt                @map("taxable_minor")
  cgstMinor         BigInt                @default(0) @map("cgst_minor")
  sgstMinor         BigInt                @default(0) @map("sgst_minor")
  igstMinor         BigInt                @default(0) @map("igst_minor")
  totalMinor        BigInt                @map("total_minor")
  currency          String                @default("INR")
  status            PlatformInvoiceStatus @default(ISSUED)
  providerPaymentId String?               @unique @map("provider_payment_id")
  createdAt         DateTime              @default(now()) @map("created_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  payments PlatformPayment[]

  @@index([tenantId, issueDate])
  @@map("platform_invoice")
  @@schema("platform")
}

model PlatformPayment {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  invoiceId         String?  @map("invoice_id") @db.Uuid
  providerPaymentId String   @unique @map("provider_payment_id")
  amountMinor       BigInt   @map("amount_minor")
  currency          String   @default("INR")
  method            String?
  capturedAt        DateTime @map("captured_at")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  invoice PlatformInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, capturedAt])
  @@map("platform_payment")
  @@schema("platform")
}

model PlatformWebhookEvent {
  id          String                @id @default(uuid()) @db.Uuid
  eventId     String                @unique @map("event_id")
  type        String
  payload     Json
  status      PlatformWebhookStatus @default(RECEIVED)
  attempts    Int                   @default(0)
  error       String?
  receivedAt  DateTime              @default(now()) @map("received_at")
  processedAt DateTime?             @map("processed_at")

  @@index([status, receivedAt])
  @@map("platform_webhook_event")
  @@schema("platform")
}

/// Dunning and trial emails sent to owners; dedupe_key makes each one go out once.
model DunningAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  stage     String
  dedupeKey String   @unique @map("dedupe_key")
  emails    String[] @default([])
  sentAt    DateTime @default(now()) @map("sent_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sentAt])
  @@map("dunning_attempt")
  @@schema("platform")
}

model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  planCodes   String[]             @default([]) @map("plan_codes")
  statuses    SubscriptionStatus[] @default([])
  startsAt    DateTime             @map("starts_at")
  endsAt      DateTime?            @map("ends_at")
  createdById String?              @map("created_by_id") @db.Uuid
  archivedAt  DateTime?            @map("archived_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([startsAt])
  @@map("announcement")
  @@schema("platform")
}

/// Gap-free counters for platform documents (SaaS invoice numbers), locked FOR UPDATE.
model PlatformCounter {
  key   String @id
  value Int    @default(0)

  @@map("platform_counter")
  @@schema("platform")
}

// ===================================================================================
// M5: CRM — leads, pipeline, follow-up tasks, trials, capture forms, API keys, campaigns,
// domain events (outbox topic "event") and their idempotent consumers.
// ===================================================================================

/// Fixed meaning behind every custom stage, so funnel reports never break.
enum LeadStageCategory {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  TRIAL_ATTENDED
  OFFER_SENT
  WON
  LOST

  @@schema("app")
}

enum LeadStatus {
  OPEN
  WON
  LOST

  @@schema("app")
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STAGE_CHANGE
  ASSIGNMENT
  TASK
  TRIAL
  CAPTURE
  CONVERSION
  SYSTEM

  @@schema("app")
}

enum FollowUpTaskStatus {
  OPEN
  DONE
  CANCELLED

  @@schema("app")
}

enum FollowUpTaskKind {
  FIRST_CONTACT
  FOLLOW_UP
  CALLBACK
  TRIAL
  OTHER

  @@schema("app")
}

enum TrialStatus {
  BOOKED
  ATTENDED
  NO_SHOW
  CANCELLED

  @@schema("app")
}

enum CampaignChannel {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  WHATSAPP
  SMS
  EMAIL
  WEBSITE
  FLYER
  REFERRAL
  EVENT
  OTHER

  @@schema("app")
}

enum LeadAssignmentMode {
  MANUAL
  ROUND_ROBIN

  @@schema("app")
}

model LeadStage {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  name       String
  category   LeadStageCategory
  position   Int
  archivedAt DateTime?         @map("archived_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads  Lead[]

  @@unique([tenantId, id])
  @@index([tenantId, position])
  @@map("lead_stage")
  @@schema("app")
}

model LeadSource {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  /// Stable key, e.g. "website", "walk_in"; matched against utm_source on capture.
  code       String
  /// Score points a lead from this source starts with (transparent scoring).
  points     Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  leads  Lead[]
  forms  LeadCaptureForm[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("lead_source")
  @@schema("app")
}

model LostReason {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads  Lead[]

  @@unique([tenantId, id])
  @@map("lost_reason")
  @@schema("app")
}

model Campaign {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  name        String
  channel     CampaignChannel
  /// Tracking code; matched (case-insensitive) against utm_campaign on capture.
  code        String
  startsOn    DateTime?       @map("starts_on") @db.Date
  endsOn      DateTime?       @map("ends_on") @db.Date
  budgetMinor BigInt?         @map("budget_minor")
  archivedAt  DateTime?       @map("archived_at")
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  leads               Lead[]
  forms               LeadCaptureForm[]
  // --- M6: sending to an audience (WhatsApp template)
  segmentId           String?             @map("segment_id") @db.Uuid
  templateId          String?             @map("template_id") @db.Uuid
  /// Template placeholder → field (validated), e.g. {"1": "member.firstName"}.
  variableMap         Json?               @map("variable_map")
  sendStatus          CampaignSendStatus  @default(NONE) @map("send_status")
  scheduledAt         DateTime?           @map("scheduled_at")
  launchedAt          DateTime?           @map("launched_at")
  completedAt         DateTime?           @map("completed_at")
  cancelledAt         DateTime?           @map("cancelled_at")
  launchedById        String?             @map("launched_by_id") @db.Uuid
  throttlePerMinute   Int                 @default(60) @map("throttle_per_minute")
  /// Renewals/payments/conversions by recipients within this many days are attributed.
  attributionDays     Int                 @default(14) @map("attribution_days")
  estimatedRecipients Int?                @map("estimated_recipients")
  segment             Segment?            @relation(fields: [tenantId, segmentId], references: [tenantId, id])
  recipients          CampaignRecipient[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("campaign")
  @@schema("app")
}

model Lead {
  id                    String     @id @default(uuid()) @db.Uuid
  tenantId              String     @map("tenant_id") @db.Uuid
  branchId              String     @map("branch_id") @db.Uuid
  firstName             String     @map("first_name")
  lastName              String?    @map("last_name")
  /// E.164 (normalizePhone), used for duplicate checks.
  phone                 String?
  /// Lower-cased.
  email                 String?
  /// What they asked about: plan, goal, preferred time.
  interest              String?
  sourceId              String?    @map("source_id") @db.Uuid
  campaignId            String?    @map("campaign_id") @db.Uuid
  utmSource             String?    @map("utm_source")
  utmMedium             String?    @map("utm_medium")
  utmCampaign           String?    @map("utm_campaign")
  utmTerm               String?    @map("utm_term")
  utmContent            String?    @map("utm_content")
  referrer              String?
  /// {sourceId, campaignId, utm..., at, via}: the first and the latest enquiry.
  firstTouch            Json?      @map("first_touch")
  lastTouch             Json?      @map("last_touch")
  stageId               String     @map("stage_id") @db.Uuid
  ownerUserId           String?    @map("owner_user_id") @db.Uuid
  status                LeadStatus @default(OPEN)
  score                 Int        @default(0)
  lostReasonId          String?    @map("lost_reason_id") @db.Uuid
  lostNote              String?    @map("lost_note")
  convertedMemberId     String?    @map("converted_member_id") @db.Uuid
  convertedMembershipId String?    @map("converted_membership_id") @db.Uuid
  captureFormId         String?    @map("capture_form_id") @db.Uuid
  /// Consent as given on the form or to staff: the exact text shown, and when.
  consentText           String?    @map("consent_text")
  consentAt             DateTime?  @map("consent_at")
  marketingConsent      Boolean    @default(false) @map("marketing_consent")
  firstContactedAt      DateTime?  @map("first_contacted_at")
  lastContactedAt       DateTime?  @map("last_contacted_at")
  /// Set once when the first-contact SLA was missed (the event fires once).
  slaBreachedAt         DateTime?  @map("sla_breached_at")
  wonAt                 DateTime?  @map("won_at")
  lostAt                DateTime?  @map("lost_at")
  createdById           String?    @map("created_by_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  branch              Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id])
  stage               LeadStage        @relation(fields: [tenantId, stageId], references: [tenantId, id])
  source              LeadSource?      @relation(fields: [tenantId, sourceId], references: [tenantId, id])
  campaign            Campaign?        @relation(fields: [tenantId, campaignId], references: [tenantId, id])
  lostReason          LostReason?      @relation(fields: [tenantId, lostReasonId], references: [tenantId, id])
  convertedMember     MemberProfile?   @relation("LeadConvertedMember", fields: [tenantId, convertedMemberId], references: [tenantId, id])
  convertedMembership Membership?      @relation("LeadConvertedMembership", fields: [tenantId, convertedMembershipId], references: [tenantId, id])
  captureForm         LeadCaptureForm? @relation(fields: [tenantId, captureFormId], references: [tenantId, id])
  activities          LeadActivity[]
  tasks               FollowUpTask[]
  trials              TrialBooking[]
  memberships         Membership[]     @relation("MembershipLead")
  conversations       Conversation[]
  consents            ContactConsent[]
  referral            Referral?

  @@unique([tenantId, id])
  @@index([tenantId, status, stageId])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, ownerUserId, status])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, campaignId])
  @@map("lead")
  @@schema("app")
}

/// The lead's timeline. Append-only for the app role.
model LeadActivity {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  leadId    String           @map("lead_id") @db.Uuid
  type      LeadActivityType
  body      String?
  /// e.g. {from, to} for stage changes, {outcome, minutes} for calls.
  meta      Json?
  userId    String?          @map("user_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  lead Lead @relation(fields: [tenantId, leadId], references: [tenantId, id])

  @@index([tenantId, leadId, createdAt])
  @@map("lead_activity")
  @@schema("app")
}

model FollowUpTask {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  branchId       String             @map("branch_id") @db.Uuid
  kind           FollowUpTaskKind   @default(FOLLOW_UP)
  title          String
  notes          String?
  dueAt          DateTime           @map("due_at")
  assigneeUserId String?            @map("assignee_user_id") @db.Uuid
  status         FollowUpTaskStatus @default(OPEN)
  leadId         String?            @map("lead_id") @db.Uuid
  memberId       String?            @map("member_id") @db.Uuid
  outcome        String?
  remindedAt     DateTime?          @map("reminded_at")
  completedAt    DateTime?          @map("completed_at")
  completedById  String?            @map("completed_by_id") @db.Uuid
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  branch Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id])
  lead   Lead?          @relation(fields: [tenantId, leadId], references: [tenantId, id])
  member MemberProfile? @relation(fields: [tenantId, memberId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, assigneeUserId, status, dueAt])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, leadId])
  @@map("follow_up_task")
  @@schema("app")
}

model TrialBooking {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  branchId       String      @map("branch_id") @db.Uuid
  leadId         String      @map("lead_id") @db.Uuid
  /// Into a class (takes a seat) or a free slot (startsAt/endsAt only).
  classSessionId String?     @map("class_session_id") @db.Uuid
  startsAt       DateTime    @map("starts_at")
  endsAt         DateTime    @map("ends_at")
  trainerUserId  String?     @map("trainer_user_id") @db.Uuid
  status         TrialStatus @default(BOOKED)
  /// Temporary trial pass: random, no PII; the QR shows `GT1.<passCode>`. Valid on the trial day only.
  passCode       String      @unique @map("pass_code")
  notes          String?
  attendedAt     DateTime?   @map("attended_at")
  attendedVia    String?     @map("attended_via")
  cancelledAt    DateTime?   @map("cancelled_at")
  reminderSentAt DateTime?   @map("reminder_sent_at")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  branch       Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id])
  lead         Lead          @relation(fields: [tenantId, leadId], references: [tenantId, id])
  classSession ClassSession? @relation(fields: [tenantId, classSessionId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, branchId, startsAt])
  @@index([tenantId, leadId])
  @@index([tenantId, classSessionId])
  @@index([tenantId, attendedAt])
  @@map("trial_booking")
  @@schema("app")
}

model LeadCaptureForm {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  /// Public key in /l/{tenantSlug}/{key}: random, unguessable, unique across tenants.
  key           String    @unique
  name          String
  title         String
  intro         String?
  /// Optional fields shown: "email", "interest", "preferredTime", "message".
  fields        String[]  @default(["email", "interest"])
  /// Required consent checkbox text, stored with each lead.
  consentText   String    @map("consent_text")
  /// Optional second checkbox for offers (marketing).
  marketingText String?   @map("marketing_text")
  thankYou      String    @map("thank_you")
  sourceId      String?   @map("source_id") @db.Uuid
  campaignId    String?   @map("campaign_id") @db.Uuid
  /// Sites allowed to embed the form (frame-ancestors); empty = this app only.
  embedOrigins  String[]  @default([]) @map("embed_origins")
  archivedAt    DateTime? @map("archived_at")
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  branch   Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id])
  source   LeadSource? @relation(fields: [tenantId, sourceId], references: [tenantId, id])
  campaign Campaign?   @relation(fields: [tenantId, campaignId], references: [tenantId, id])
  leads    Lead[]

  @@unique([tenantId, id])
  @@map("lead_capture_form")
  @@schema("app")
}

/// Integration keys for the public API. Only a SHA-256 of the secret is stored.
model TenantApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  /// Public part of the key (`gk_<prefix>_<secret>`), unique across tenants; used for lookup.
  prefix      String    @unique
  secretHash  String    @map("secret_hash")
  scopes      String[]
  /// Leads created with this key go to this branch.
  branchId    String    @map("branch_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@map("tenant_api_key")
  @@schema("app")
}

model LeadSavedView {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  /// The list filters (validated on use).
  filters   Json
  /// Visible to everyone in the gym who can see leads.
  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@map("lead_saved_view")
  @@schema("app")
}

/// Round-robin pointer per branch: the last person given a lead.
model LeadAssignmentCursor {
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  lastUserId String?  @map("last_user_id") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@id([tenantId, branchId])
  @@map("lead_assignment_cursor")
  @@schema("app")
}

/// Idempotent event consumers: one row per (event, handler) that has run.
model EventConsumption {
  tenantId  String   @map("tenant_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  handler   String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, eventId, handler])
  @@map("event_consumption")
  @@schema("app")
}

