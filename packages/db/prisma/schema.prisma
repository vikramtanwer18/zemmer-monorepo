  tenantId     String         @map("tenant_id") @db.Uuid
  memberId     String         @map("member_id") @db.Uuid
  authorUserId String         @map("author_user_id") @db.Uuid
  body         String
  visibility   NoteVisibility @default(STAFF)
  createdAt    DateTime       @default(now()) @map("created_at")

  member MemberProfile @relation(fields: [tenantId, memberId], references: [tenantId, id])

  @@index([tenantId, memberId, createdAt])
  @@map("member_note")
  @@schema("app")
}

model MemberDocument {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  member MemberProfile @relation(fields: [tenantId, memberId], references: [tenantId, id])
  file   FileRecord    @relation(fields: [tenantId, fileId], references: [tenantId, id])

  @@index([tenantId, memberId])
  @@map("member_document")
  @@schema("app")
}

/// Append-only consent history; the latest row per (member, channel, purpose) is current.
model ContactConsent {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  memberId         String?        @map("member_id") @db.Uuid
  channel          ConsentChannel
  purpose          ConsentPurpose
  status           ConsentStatus
  method           ConsentMethod
  capturedByUserId String?        @map("captured_by_user_id") @db.Uuid
  capturedAt       DateTime       @default(now()) @map("captured_at")
  /// What the person saw or said, e.g. the checkbox text.
  evidence         String?

  member MemberProfile? @relation(fields: [tenantId, memberId], references: [tenantId, id])
  leadId String?        @map("lead_id") @db.Uuid
  lead   Lead?          @relation(fields: [tenantId, leadId], references: [tenantId, id])

  @@index([tenantId, memberId, channel, purpose, capturedAt])
  @@map("contact_consent")
  @@schema("app")
}

model MembershipPlan {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  /// Stable across versions; editing a sold plan creates code@version+1.
  code               String
  version            Int                  @default(1)
  name               String
  description        String?
  priceMinor         BigInt               @map("price_minor")
  joiningFeeMinor    BigInt               @default(0) @map("joining_fee_minor")
  currency           String               @default("INR")
  durationUnit       DurationUnit         @map("duration_unit")
  durationCount      Int                  @map("duration_count")
  taxRateBps         Int                  @default(1800) @map("tax_rate_bps")
  sacCode            String               @default("999723") @map("sac_code")
  isTrial            Boolean              @default(false) @map("is_trial")
  accessScope        AccessScope          @default(HOME_BRANCH) @map("access_scope")
  /// [{ days: [1..7], from: "06:00", to: "22:00" }] or null = any time. Enforced from M3.
  accessWindows      Json?                @map("access_windows")
  /// { classCredits?: number | null, ptSessions?: number | null }. Consumed from M3.
  entitlements       Json                 @default("{}")
  freezeMaxDays      Int                  @default(0) @map("freeze_max_days")
  freezeMaxTimes     Int                  @default(0) @map("freeze_max_times")
  freezeFeeMinor     BigInt               @default(0) @map("freeze_fee_minor")
  graceDays          Int                  @default(0) @map("grace_days")
  allowAddOn         Boolean              @default(false) @map("allow_add_on")
  refundRule         RefundRule           @default(NONE) @map("refund_rule")
  cancellationPolicy String?              @map("cancellation_policy")
  /// M4: members may buy this plan in the app.
  onlinePurchase     Boolean              @default(false) @map("online_purchase")
  status             MembershipPlanStatus @default(ACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  branches    PlanBranch[]
  memberships Membership[]

  @@unique([tenantId, id])
  @@unique([tenantId, code, version])
  @@index([tenantId, status])
  @@map("membership_plan")
  @@schema("app")
}

/// Where a plan is sold, and (for LISTED_BRANCHES) where it grants access.
model PlanBranch {
  tenantId String @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  plan   MembershipPlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Cascade)
  branch Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@id([tenantId, planId, branchId])
  @@map("plan_branch")
  @@schema("app")
}

model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  /// Upper-case, unique per tenant.
  code           String
  kind           CouponKind
  /// PERCENT: basis points (1000 = 10%). FLAT: paise.
  value          Int
  validFrom      DateTime?    @map("valid_from") @db.Date
  validTo        DateTime?    @map("valid_to") @db.Date
  maxRedemptions Int?         @map("max_redemptions")
  redemptions    Int          @default(0)
  /// Plan codes it applies to; empty = every plan.
  planCodes      String[]     @default([]) @map("plan_codes")
  status         CouponStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  memberships Membership[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("coupon")
  @@schema("app")
}

model Membership {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  memberId      String          @map("member_id") @db.Uuid
  planId        String          @map("plan_id") @db.Uuid
  /// Branch where it was sold.
  branchId      String          @map("branch_id") @db.Uuid
  status        MembershipState
  /// Local dates in the tenant timezone; the membership covers [startDate, endDate] inclusive.
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime        @map("end_date") @db.Date
  priceMinor    BigInt          @map("price_minor")
  discountMinor BigInt          @default(0) @map("discount_minor")
  couponId      String?         @map("coupon_id") @db.Uuid
  renewedFromId String?         @map("renewed_from_id") @db.Uuid
  frozenDays    Int             @default(0) @map("frozen_days")
  freezeCount   Int             @default(0) @map("freeze_count")
  activatedAt   DateTime?       @map("activated_at")
  cancelledAt   DateTime?       @map("cancelled_at")
  cancelReason  String?         @map("cancel_reason")
  createdById   String?         @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  member             MemberProfile       @relation(fields: [tenantId, memberId], references: [tenantId, id])
  plan               MembershipPlan      @relation(fields: [tenantId, planId], references: [tenantId, id])
  branch             Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id])
  coupon             Coupon?             @relation(fields: [tenantId, couponId], references: [tenantId, id])
  events             MembershipEvent[]
  freezes            MembershipFreeze[]
  invoices           GymInvoice[]
  bookings           Booking[]
  entitlementEntries EntitlementLedger[]
  /// M5: the lead this sale converted (lead becomes WON when it activates).
  leadId             String?             @map("lead_id") @db.Uuid
  lead               Lead?               @relation("MembershipLead", fields: [tenantId, leadId], references: [tenantId, id])
  convertedLeads     Lead[]              @relation("LeadConvertedMembership")

  @@unique([tenantId, id])
  @@index([tenantId, memberId])
  @@index([tenantId, status, endDate])
  @@map("membership")
  @@schema("app")
}

model MembershipEvent {
