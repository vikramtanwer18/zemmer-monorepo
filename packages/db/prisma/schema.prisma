  @@unique([tenantId, id])
  @@map("automation_workflow")
  @@schema("app")
}

/// Immutable: editing a workflow creates the next version; executions point at the version they ran.
model AutomationWorkflowVersion {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  version     Int
  definition  Json
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  workflow   AutomationWorkflow    @relation(fields: [tenantId, workflowId], references: [tenantId, id])
  executions AutomationExecution[]

  @@unique([tenantId, id])
  @@unique([tenantId, workflowId, version])
  @@map("automation_workflow_version")
  @@schema("app")
}

model AutomationExecution {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  workflowId  String                    @map("workflow_id") @db.Uuid
  versionId   String                    @map("version_id") @db.Uuid
  /// Event id, or a scan key like "expiring:<membershipId>:7". Unique per version: never twice.
  triggerKey  String                    @map("trigger_key")
  triggerType String                    @map("trigger_type")
  memberId    String?                   @map("member_id") @db.Uuid
  leadId      String?                   @map("lead_id") @db.Uuid
  /// Facts from the trigger (ids, dates) the steps may use.
  context     Json
  status      AutomationExecutionStatus @default(RUNNING)
  nextStep    Int                       @default(0) @map("next_step")
  resumeAt    DateTime?                 @map("resume_at")
  error       String?
  startedAt   DateTime                  @default(now()) @map("started_at")
  finishedAt  DateTime?                 @map("finished_at")

  workflow AutomationWorkflow        @relation(fields: [tenantId, workflowId], references: [tenantId, id])
  version  AutomationWorkflowVersion @relation(fields: [tenantId, versionId], references: [tenantId, id])
  steps    AutomationStepRun[]

  @@unique([tenantId, id])
  @@unique([tenantId, versionId, triggerKey])
  @@index([tenantId, status, resumeAt])
  @@index([tenantId, workflowId, startedAt])
  @@map("automation_execution")
  @@schema("app")
}

model AutomationStepRun {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  executionId  String               @map("execution_id") @db.Uuid
  stepIndex    Int                  @map("step_index")
  type         String
  status       AutomationStepStatus
  result       Json?
  attempts     Int                  @default(1)
  approvedById String?              @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?            @map("approved_at")
  startedAt    DateTime             @default(now()) @map("started_at")
  finishedAt   DateTime?            @map("finished_at")

  execution AutomationExecution @relation(fields: [tenantId, executionId], references: [tenantId, id])

  @@unique([tenantId, executionId, stepIndex])
  @@map("automation_step_run")
  @@schema("app")
}

/// A gym's thresholds for each retention signal.
model RetentionRule {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  kind      RetentionRuleKind
  enabled   Boolean           @default(true)
  /// Days, percent or count depending on the kind.
  threshold Int
  updatedAt DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kind])
  @@map("retention_rule")
  @@schema("app")
}

/// "This member/lead needs attention because <rule>". One open flag per subject per rule.
model RetentionFlag {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  branchId     String?             @map("branch_id") @db.Uuid
  memberId     String?             @map("member_id") @db.Uuid
  leadId       String?             @map("lead_id") @db.Uuid
  kind         RetentionRuleKind
  /// Plain-language reason, e.g. "No visit for 16 days (rule: 14)".
  reason       String
  details      Json?
  status       RetentionFlagStatus @default(OPEN)
  action       String?
  actionedAt   DateTime?           @map("actioned_at")
  actionedById String?             @map("actioned_by_id") @db.Uuid
  resolvedAt   DateTime?           @map("resolved_at")
  outcome      String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  outcomes RecoveryOutcome[]

  @@unique([tenantId, id])
  @@index([tenantId, status, kind])
  @@map("retention_flag")
  @@schema("app")
}

/// Something good that happened after we flagged, reminded or messaged (associated, not causal).
model RecoveryOutcome {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  kind        RecoveryKind
  memberId    String?      @map("member_id") @db.Uuid
  leadId      String?      @map("lead_id") @db.Uuid
  flagId      String?      @map("flag_id") @db.Uuid
  campaignId  String?      @map("campaign_id") @db.Uuid
  executionId String?      @map("execution_id") @db.Uuid
  /// What happened: the membership, payment, check-in or lead id.
  refId       String       @map("ref_id")
  amountMinor BigInt?      @map("amount_minor")
  occurredAt  DateTime     @map("occurred_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  flag RetentionFlag? @relation(fields: [tenantId, flagId], references: [tenantId, id])

  @@unique([tenantId, kind, refId])
  @@index([tenantId, occurredAt])
  @@map("recovery_outcome")
  @@schema("app")
}

