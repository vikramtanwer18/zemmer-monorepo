// ===================================================================================

enum PassStatus {
  ACTIVE
  REVOKED

  @@schema("app")
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT

  @@schema("app")
}

enum AttendanceMethod {
  QR
  MANUAL
  CORRECTION

  @@schema("app")
}

enum AttendanceResult {
  ACCEPTED
  REJECTED

  @@schema("app")
}

enum DuesCheckinPolicy {
  WARN
  BLOCK

  @@schema("app")
}

/// Lifecycle of configuration records (devices, rooms, categories, class templates, PT packages).
enum RecordStatus {
  ACTIVE
  ARCHIVED

  @@schema("app")
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED

  @@schema("app")
}

enum BookingStatus {
  BOOKED
  CANCELLED
  ATTENDED
  NO_SHOW

  @@schema("app")
}

enum BookingSource {
  MEMBER_APP
  STAFF
  WAITLIST

  @@schema("app")
}

enum WaitlistStatus {
  WAITING
  PROMOTED
  LEFT
  SKIPPED
  EXPIRED

  @@schema("app")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT

  @@schema("app")
}

enum PayBasis {
  MONTHLY
  HOURLY
  PER_SESSION

  @@schema("app")
}

enum AvailabilityKind {
  WEEKLY
  EXCEPTION

  @@schema("app")
}

enum PtBalanceStatus {
