  @@unique([tenantId, logId, exerciseId, setNumber])
  @@map("set_log")
  @@schema("app")
}

/// A best-ever for one exercise and kind; history kept (newest = current), with the set that made it.
model PersonalRecord {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  memberId   String             @map("member_id") @db.Uuid
  exerciseId String             @map("exercise_id") @db.Uuid
  kind       PersonalRecordKind
  value      Decimal            @db.Decimal(10, 2)
  previous   Decimal?           @db.Decimal(10, 2)
  setLogId   String             @map("set_log_id") @db.Uuid
  logId      String             @map("log_id") @db.Uuid
  achievedAt DateTime           @map("achieved_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  member   MemberProfile @relation(fields: [tenantId, memberId], references: [tenantId, id])
  exercise Exercise      @relation(fields: [tenantId, exerciseId], references: [tenantId, id])
  setLog   SetLog        @relation(fields: [tenantId, setLogId], references: [tenantId, id])
