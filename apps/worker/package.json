    "esbuild": "^0.28.2",
    "eslint": "10.9.1",
    "tsx": "^4",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@gym/auth": "workspace:*",
    "@gym/core": "workspace:*",
    "@gym/db": "workspace:*",
    "@gym/env": "workspace:*",
    "@gym/integrations": "workspace:*",
    "bullmq": "^6.5.3",
    "dotenv": "^18.0.9",
    "ioredis": "5.11.1"
  }
