# Copy to .env for local development: cp .env.example .env
# These are local development values only. Real secrets never go in this file.

# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Product name shown in emails and page titles.
APP_NAME="Gym SaaS"

# --- Auth (two separate realms, D-03). Generate real values with: openssl rand -base64 32 ---
# Tenant realm (apps/web): staff, owners, members.
AUTH_SECRET=dev-only-tenant-auth-secret-0123456789abcdef
# Platform realm (apps/admin). Must differ from AUTH_SECRET.
ADMIN_AUTH_SECRET=dev-only-platform-auth-secret-0123456789abcdef
# Google sign-in for staff/owners. Leave empty to hide the Google button.
# Redirect URI to register with Google: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Key-encryption key for secrets stored in the database (member pass secrets, later payment and
# WhatsApp credentials). Production: from Secrets Manager. When rotating, put the old value in
# DATA_ENCRYPTION_KEY_PREVIOUS until every record has been re-encrypted.
DATA_ENCRYPTION_KEY=dev-only-data-encryption-key-0123456789abcdef
DATA_ENCRYPTION_KEY_PREVIOUS=
# Signs gym-app → admin-app requests (SaaS subscription checkout). Same value for web and admin.
PLATFORM_INTERNAL_SECRET=dev-only-platform-internal-secret-0123456789abcdef
# Fake payment provider for development, tests and demos (never in production): gyms can connect
# "Test provider" and pay on a local checkout page instead of Razorpay.
PAYMENTS_FAKE_ENABLED=true

# --- PostgreSQL (docker-compose service "postgres") ---
# Owner role: migrations and seeds only.
MIGRATION_DATABASE_URL=postgresql://gym_owner:gym_owner_dev_pw@localhost:5432/gym
# Runtime role for web + worker (row-level security applies).
DATABASE_URL=postgresql://gym_app:gym_app_dev_pw@localhost:5432/gym
# Runtime role for admin (platform schema only).
PLATFORM_DATABASE_URL=postgresql://gym_platform:gym_platform_dev_pw@localhost:5432/gym

# --- Redis (docker-compose service "redis") ---
REDIS_URL=redis://localhost:6379

# --- Worker ---
WORKER_HEALTH_PORT=4100

# --- File storage (MinIO locally; on AWS drop S3_ENDPOINT and S3_FORCE_PATH_STYLE) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=gym-dev-uploads
S3_ACCESS_KEY_ID=gym_minio
S3_SECRET_ACCESS_KEY=gym_minio_dev_pw
S3_FORCE_PATH_STYLE=true

# --- Email ---
# smtp (Mailpit locally) | ses (AWS, needs SES_REGION) | memory (tests; nothing is sent)
EMAIL_PROVIDER=smtp
SES_REGION=
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="My Gym <no-reply@gym.local>"

# --- WhatsApp (M6, D-12). From the operator's Meta app (developers.facebook.com → App → Settings).
# Leave empty until the Meta app exists: the webhook then refuses everything.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Embedded Signup (only after Meta Tech Provider approval; also switch it on in the admin console).
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Fake WhatsApp for development, tests and demos (never in production): no message leaves the machine.
WHATSAPP_FAKE_ENABLED=true

# --- AI Copilot (M8, D-13). The provider (OpenAI-compatible base URL, model, key) is set by a platform
# admin in the console (Settings → AI) and stored encrypted. The fake answers deterministically from the
# gym's data without calling any provider: development, tests and demos only (never in production).
AI_FAKE_ENABLED=true
