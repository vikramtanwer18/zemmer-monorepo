{
  "name": "gym-saas",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d --wait postgres redis minio mailpit && docker compose run --rm minio-init",
    "services:down": "docker compose down",
    "db:migrate": "pnpm --filter @gym/db db:migrate",
    "db:deploy": "pnpm --filter @gym/db db:deploy",
    "db:seed": "pnpm --filter @gym/auth seed:demo",
    "metrics:rebuild": "pnpm --filter @gym/auth metrics:rebuild",
    "ai:eval": "pnpm --filter @gym/auth exec tsx ../../apps/web/ai-evals/run.ts",
    "platform:create-admin": "pnpm --filter @gym/auth create-admin",
    "docs:permissions": "pnpm --filter @gym/auth docs:permissions",
    "typecheck": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
